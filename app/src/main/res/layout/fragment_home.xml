<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".dashboard.Home">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dashboard_middle_background">

        <LinearLayout
            android:id="@+id/top_background"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:background="@drawable/dashboard_top_background"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profilePic"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_icon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:shapeAppearanceOverlay="@style/circular"
                        app:strokeColor="@color/brown"
                        app:strokeWidth="2dp"
                        tools:ignore="SpeakableTextPresentCheck" />

                    <TextView
                        android:id="@+id/dashboardNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/profilePic"
                        app:layout_constraintEnd_toStartOf="@+id/notificationBttn"/>

                    <ImageView
                        android:id="@+id/notificationBttn"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_notifications_24"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="10dp"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:id="@+id/linView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:orientation="vertical"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODAY'S TIME"
                            android:fontFamily="@font/poppins_bold"/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="30dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/timeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="am/pm"
                                android:fontFamily="@font/poppins"
                                android:layout_marginStart="5dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/time"
                                android:layout_marginTop="10dp"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/checkInText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check In at"
                                android:fontFamily="@font/poppins"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/checkInTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_bold"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/checkInText"
                                android:layout_marginStart="5dp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/checkOutText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check Out at"
                                android:fontFamily="@font/poppins"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/checkOutTime"
                                android:layout_marginEnd="5dp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/checkOutTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_bold"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginEnd="20dp"
                                android:layout_marginTop="10dp"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:layout_width="170dp"
                                android:layout_height="wrap_content"
                                app:trackColor="@color/light_green"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:layout_width="170dp"
                                android:layout_height="wrap_content"
                                app:trackColor="@color/orange"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/resetBttn"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginStart="40dp"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="50dp"
                            android:layout_marginEnd="40dp"
                            android:background="@drawable/btn_reset"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Reset"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/top_background"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="0dp"
            android:background="@drawable/dashboard_bottom_background"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/upcomingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard Management"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="30dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/linearUpcoming"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:id="@+id/linearUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/upcomingText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_margin="10dp"
                            android:background="#f8f8f8"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/baseline_event_24"
                                    android:tint="#5CABE9"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginStart="15dp"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Attendance"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginEnd="15dp"/>

                                <TextView
                                    android:id="@+id/totalAttendance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="#5CABE9"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/attendanceBttn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/btn_login"
                                    android:fontFamily="@font/poppins"
                                    android:text="see all"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    tools:ignore="TouchTargetSizeCheck" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_margin="10dp"
                            android:background="#f8f8f8"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:tint="#ECDB00"
                                    android:src="@drawable/baseline_work_24"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginStart="15dp"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Status"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <TextView
                                    android:id="@+id/emplyeeStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="#ECDB00"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/statusBttn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/btn_login"
                                    android:fontFamily="@font/poppins"
                                    android:text="see all"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    tools:ignore="TouchTargetSizeCheck" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_margin="10dp"
                            android:background="#f8f8f8"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/baseline_access_time_24"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginStart="15dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Time In"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <TextView
                                    android:id="@+id/totalTimeIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="#F04336"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/timeInBttn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/btn_login"
                                    android:fontFamily="@font/poppins"
                                    android:text="see all"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    tools:ignore="TouchTargetSizeCheck" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_margin="10dp"
                            android:background="#f8f8f8"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/baseline_av_timer_24"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginStart="15dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Time Out"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <TextView
                                    android:id="@+id/totalTimeOut"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="#12D10A"
                                    android:textStyle="bold"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginStart="15dp"/>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/timeOutBttn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/btn_login"
                                    android:fontFamily="@font/poppins"
                                    android:text="see all"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    tools:ignore="TouchTargetSizeCheck" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>